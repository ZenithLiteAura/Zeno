<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-sdk tools:overrideLibrary="top.yukonga.miuix.kmp.blur" />

    <!-- Android 11+ 包可见性：不加会把「已装 Shizuku」误判成「未安装」 -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <!-- 通知：前台服务常驻通知 + 收录成功提示（Android 13+ 运行时权限） -->
    <!-- Shizuku：用于「把 Service 跑在 shell 进程里读剪贴板」的授权接口 -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- 抖音解析与媒体下载 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 下载用前台服务（Android 14+ 需要 dataSync 类型） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 9 及以下写公有目录（MediaStore 从 29 起免权限） -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 前台服务：常驻监听服务需要 specialUse 子类型（Android 14+ 强制） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 开机自启：重启后恢复监听服务 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 悬浮球：Android 10+ 后台读剪贴板的现实解法（点击时抢一次前台） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- root/系统应用增强：装进 /system/priv-app 后才有（普通安装拿不到，系统直接忽略） -->
    <uses-permission
        android:name="android.permission.READ_CLIPBOARD_IN_BACKGROUND"
        tools:ignore="ProtectedPermissions" />

    <!-- 电池白名单：避免国产 ROM 把常驻服务回收 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".ClipNestApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Nezo">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 崩溃诊断页：独立进程 + 纯 Android 视图，Compose/MiUiX 崩了也能显示 -->
        <activity
            android:name=".CrashActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:process=":crash"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar" />

        <!-- 通路 B：分享到Nezo（最可靠的后台收录方式，零权限） -->
        <activity
            android:name=".platform.ShareReceiverActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- 通路 C：透明一键收录页（悬浮球 / 通知按钮拉起，抢一次前台读剪贴板后立即关闭） -->
        <activity
            android:name=".platform.QuickCaptureActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 常驻前台服务：常驻通知（暂停/继续、一键收录、打开Nezo）+ 保活悬浮球 -->
        <service
            android:name=".platform.MonitorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="clipboard-capture" />
        </service>


        <!-- 下载前台服务：解析结果下载 / ZIP 打包，带进度通知 -->
        <service
            android:name=".platform.download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 开机自启 / 应用更新后恢复监听服务 -->
        <receiver
            android:name=".platform.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Shizuku API 的 binder 接收入口（Shizuku 应用通过它把 shell 服务的 binder 递给我们） -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false" />

        <!-- 导出：把文本写成缓存文件后通过 FileProvider 分享出去 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>